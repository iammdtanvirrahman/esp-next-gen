{
  "version": "2.0.0",
  "scope": "core",
  "libraries": [
    {
      "id": "arduino-core",
      "name": "Arduino Core Compatibility",
      "header": "Arduino.h",
      "platform": "multi-platform",
      "functions": ["pinMode","digitalWrite","digitalRead","analogRead","analogWrite","delay","delayMicroseconds","millis","micros","yield","constrain","map","abs","min","max","random","randomSeed"],
      "keywords": ["HIGH","LOW","INPUT","OUTPUT","INPUT_PULLUP"]
    },
    {
      "id": "serial-core",
      "name": "Serial Compatibility",
      "header": "Arduino.h",
      "platform": "multi-platform",
      "functions": ["Serial.begin","Serial.print","Serial.println","Serial.printf"]
    }
  ]
}
