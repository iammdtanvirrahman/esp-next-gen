// =====================================================
// COMMAND EXECUTOR
// =====================================================

void executeCommand(
  uint8_t client,
  String json
)
{
  String command =
    getCommand(json);

  // ----------------------------------------------
  // PING
  // ----------------------------------------------

  if (command == "ping")
  {
    webSocket.sendTXT(
      client,
      "{\"type\":\"pong\"}"
    );

    return;
  }

  // ----------------------------------------------
  // PIN MODE
  // ----------------------------------------------

  if (command == "pinMode")
  {
    commandPinMode(
      client,
      json
    );

    return;
  }

  // ----------------------------------------------
  // DIGITAL WRITE
  // ----------------------------------------------

  if (command == "digitalWrite")
  {
    commandDigitalWrite(
      client,
      json
    );

    return;
  }

  // ----------------------------------------------
  // DIGITAL READ
  // ----------------------------------------------

  if (command == "digitalRead")
  {
    commandDigitalRead(
      client,
      json
    );

    return;
  }

  // ----------------------------------------------
  // ANALOG WRITE
  // PWM
  // ----------------------------------------------

  if (
    command == "analogWrite" ||
    command == "pwm"
  )
  {
    commandAnalogWrite(
      client,
      json
    );

    return;
  }

  // ----------------------------------------------
  // ANALOG READ
  // ADC
  // ----------------------------------------------

  if (
    command == "analogRead" ||
    command == "adc"
  )
  {
    commandAnalogRead(
      client,
      json
    );

    return;
  }

  // ----------------------------------------------
  // STOP
  // ----------------------------------------------

  if (command == "stop")
  {
    // Generic ESP32 has no fixed actuator.
    // Just acknowledge.
    sendAck(
      client,
      "stop"
    );

    return;
  }

  // ----------------------------------------------
  // UNKNOWN
  // ----------------------------------------------

  sendError(
    client,
    "Unsupported command"
  );
}

// =====================================================
// WEBSOCKET EVENT
// =====================================================

void webSocketEvent(
  uint8_t client,
  WStype_t type,
  uint8_t* payload,
  size_t length
)
{
  // -------------------------------------------------
  // CONNECTED
  // -------------------------------------------------

  if (
    type == WStype_CONNECTED
  )
  {
    String hello =
      "{\"type\":\"hello\",\"protocol\":\"ESP-NEXT-GEN/2\",\"device\":\"ESP32\",\"ip\":\"";

    hello +=
      WiFi.localIP().toString();

    hello +=
      "\",\"port\":81,\"executor\":\"generic-hardware\"}";

    webSocket.sendTXT(
      client,
      hello
    );

    return;
  }

  // -------------------------------------------------
  // TEXT MESSAGE
  // -------------------------------------------------

  if (
    type == WStype_TEXT
  )
  {
    String message;

    for (
      size_t i = 0;
      i < length;
      i++
    )
    {
      message +=
        (char)payload[i];
    }

    // Plain PING from current NetworkManager
    if (message == "PING")
    {
      webSocket.sendTXT(
        client,
        "PONG"
      );

      return;
    }

    // JSON command
    if (
      message.startsWith("{")
    )
    {
      executeCommand(
        client,
        message
      );

      return;
    }

    sendError(
      client,
      "Invalid command"
    );
  }
}

// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(
    115200
  );

  delay(500);

  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "ESP NEXT GEN"
  );

  Serial.println(
    "Generic Hardware Executor"
  );

  Serial.println(
    "================================"
  );

  // -------------------------------------------------
  // WIFI
  // -------------------------------------------------

  WiFi.mode(
    WIFI_STA
  );

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  Serial.print(
    "Connecting to WiFi"
  );

  while (
    WiFi.status() != WL_CONNECTED
  )
  {
    delay(500);

    Serial.print(
      "."
    );
  }

  Serial.println();

  Serial.println(
    "WiFi connected"
  );

  Serial.print(
    "ESP32 IP: "
  );

  Serial.println(
    WiFi.localIP()
  );

  // -------------------------------------------------
  // WEBSOCKET
  // -------------------------------------------------

  webSocket.begin();

  webSocket.onEvent(
    webSocketEvent
  );

  Serial.println(
    "WebSocket server ready"
  );

  Serial.print(
    "Port: "
  );

  Serial.println(
    WS_PORT
  );

  Serial.println(
    "ESP32 READY"
  );

  Serial.println(
    "================================"
  );
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
  webSocket.loop();
}
