// =====================================================
// ANALOG WRITE / PWM
// =====================================================

void commandAnalogWrite(
  uint8_t client,
  String json
)
{
  int pin =
    getValue(
      json,
      "pin"
    ).toInt();

  int value =
    getValue(
      json,
      "value"
    ).toInt();

  if (!validPin(pin))
  {
    sendError(
      client,
      "Invalid GPIO"
    );

    return;
  }

  value =
    constrain(
      value,
      0,
      255
    );

  pinMode(
    pin,
    OUTPUT
  );

  // ESP32 Arduino core supports analogWrite()
  analogWrite(
    pin,
    value
  );

  String response =
    "{\"type\":\"ack\",\"command\":\"analogWrite\",\"pin\":";

  response += pin;

  response += ",\"value\":";

  response += value;

  response += "}";

  webSocket.sendTXT(
    client,
    response
  );
}

