#include <WiFi.h>
#include <WebSocketsServer.h>

// =====================================================
// ESP NEXT GEN - GENERIC HARDWARE SERVANT
// ArduinoDroid / ESP32
// =====================================================

const char* WIFI_SSID = "taifa";
const char* WIFI_PASSWORD = "20072311";

#define WS_PORT 81

WebSocketsServer webSocket(WS_PORT);

// =====================================================
// JSON VALUE READER
// Simple parser - no ArduinoJson needed
// =====================================================

String getValue(String json, String key)
{
  String target = "\"" + key + "\"";

  int keyPos = json.indexOf(target);

  if (keyPos < 0)
    return "";

  int colon = json.indexOf(":", keyPos);

  if (colon < 0)
    return "";

  int start = colon + 1;

  while (
    start < json.length() &&
    (
      json[start] == ' ' ||
      json[start] == '\t'
    )
  )
  {
    start++;
  }

  if (start >= json.length())
    return "";

  // Quoted value
  if (json[start] == '"')
  {
    start++;

    int end = json.indexOf('"', start);

    if (end < 0)
      return "";

    return json.substring(start, end);
  }

  // Normal value
  int end = start;

  while (
    end < json.length() &&
    json[end] != ',' &&
    json[end] != '}'
  )
  {
    end++;
  }

  String value = json.substring(start, end);
  value.trim();

  return value;
}

// =====================================================
// COMMAND NAME
// Supports both:
// "type"
// "cmd"
// =====================================================

String getCommand(String json)
{
  String command = getValue(json, "type");

  if (command.length() == 0)
    command = getValue(json, "cmd");

  return command;
}

// =====================================================
// SEND ERROR
// =====================================================

void sendError(
  uint8_t client,
  String message
)
{
  String response =
    "{\"type\":\"error\",\"message\":\"";

  response += message;

  response += "\"}";

  webSocket.sendTXT(
    client,
    response
  );
}

// =====================================================
// SEND ACK
// =====================================================

void sendAck(
  uint8_t client,
  String command
)
{
  String response =
    "{\"type\":\"ack\",\"command\":\"";

  response += command;

  response += "\"}";

  webSocket.sendTXT(
    client,
    response
  );
}

// =====================================================
// CHECK GPIO
// =====================================================

bool validPin(int pin)
{
  return (
    pin >= 0 &&
    pin <= 39
  );
}

// =====================================================
// PIN MODE
// =====================================================

void commandPinMode(
  uint8_t client,
  String json
)
{
  int pin =
    getValue(
      json,
      "pin"
    ).toInt();

  String mode =
    getValue(
      json,
      "mode"
    );

  if (!validPin(pin))
  {
    sendError(
      client,
      "Invalid GPIO"
    );

    return;
  }

  if (mode == "OUTPUT")
  {
    pinMode(
      pin,
      OUTPUT
    );
  }
  else if (mode == "INPUT")
  {
    pinMode(
      pin,
      INPUT
    );
  }
  else if (
    mode == "INPUT_PULLUP"
  )
  {
    pinMode(
      pin,
      INPUT_PULLUP
    );
  }
  else if (mode == "OUTPUT")
  {
    pinMode(
      pin,
      OUTPUT
    );
  }
  else
  {
    // Also accept Arduino numeric constants
    int numericMode =
      mode.toInt();

    pinMode(
      pin,
      numericMode
    );
  }

  String response =
    "{\"type\":\"ack\",\"command\":\"pinMode\",\"pin\":";

  response += pin;

  response += "}";

  webSocket.sendTXT(
    client,
    response
  );
}

// =====================================================
// DIGITAL WRITE
// =====================================================

void commandDigitalWrite(
  uint8_t client,
  String json
)
{
  int pin =
    getValue(
      json,
      "pin"
    ).toInt();

  String value =
    getValue(
      json,
      "state"
    );

  if (value.length() == 0)
  {
    value =
      getValue(
        json,
        "value"
      );
  }

  if (!validPin(pin))
  {
    sendError(
      client,
      "Invalid GPIO"
    );

    return;
  }

  bool state =
    (
      value == "true" ||
      value == "1" ||
      value == "HIGH"
    );

  pinMode(
    pin,
    OUTPUT
  );

  digitalWrite(
    pin,
    state ? HIGH : LOW
  );

  String response =
    "{\"type\":\"ack\",\"command\":\"digitalWrite\",\"pin\":";

  response += pin;

  response += ",\"value\":";

  response += (
    state
    ? "true"
    : "false"
  );

  response += "}";

  webSocket.sendTXT(
    client,
    response
  );
}

